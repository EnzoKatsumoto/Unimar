#include <stdio.h>
#include <locale.h>
#include <stdlib.h>

typedef struct no{  // Criando o "esqueleto" dos nós da lista simplesmente encadeada
    int info;
    struct no *prox;
}no;

typedef struct extremidades{ // Criando os ponteiros que irão apontar para o "primeiro" e "último" nó
    no *inicio;
    no *fim;
} extremidades;

extremidades inicializar(){
    extremidades e; // Encapsulamento dos ponteiros inicio e fim

    e.inicio = NULL;
    e.fim = NULL;

    return e;
}


void inserir_inicio(extremidades *e, int valor){
    no* novo;
    if (e->inicio == NULL && e->fim == NULL){
        novo = malloc(sizeof(no));
        novo->info = valor;
        e->inicio = novo;
        e->fim = novo;
        novo->prox = novo;
    }
    else{

        novo = malloc(sizeof(no));
        novo->info = valor;
        novo->prox = e->inicio;
        e->inicio = novo;
        e->fim->prox = novo;
    }

}

void inserir_fim(extremidades *e, int valor){
    no* novo;
    if (e->inicio == NULL && e->fim == NULL){
        novo = malloc(sizeof(no));
        novo->info = valor;
        e->inicio = novo;
        e->fim = novo;
        novo->prox = novo;
    }
    else{

        no *aux;
        aux = e->fim;
        novo = malloc(sizeof(no));
        novo->info = valor;
        e->fim = novo;
        aux->prox = e->fim;
        novo->prox = e->inicio;

    }
}

void remover_inicio(extremidades *e){
    if (e->inicio == NULL && e->fim == NULL){
        printf("A lista está vazia\n");
        return;
    }
    if (e->inicio == e->fim){// verifica se há apenas um elemento na lista
        no *aux;
        aux = e->inicio;
        e->inicio = NULL;
        e->fim = NULL;
        free(aux);
    }
    else{
     no *aux;
     aux = e->inicio;
     e->inicio = e->inicio->prox;
     e->fim->prox = e->inicio;
     free(aux);
     }

}

void remover_fim(extremidades *e){
    if (e->inicio == NULL && e->fim == NULL){
        printf("A lista está vazia\n");
        return;
    }

    if (e->inicio == e->fim){
        no *aux;
        aux = e->inicio;
        e->inicio = NULL;
        e->fim = NULL;
        free(aux);
    }

    else{
        no *aux;
        aux = e->fim;
        e->fim = e->inicio; // fim aponta para inicio
        while (e->fim->prox != aux){
            e->fim = e->fim->prox; // utilizamos aux para o ponteiro fim apontar para o seu nó anterior, assim podemos liberar aux.
        }
        e->fim->prox = e->inicio;
        free(aux);
    }
}

void exibir_lista(extremidades *e){
    if (e->inicio == NULL && e->fim == NULL){ // verifica se a lista está vazia
        printf("A lista está vazia.\n");
        return;
    }
    if (e->inicio == e->fim){
        printf(" %d repetição...\n", e->inicio->info); // verifica se a lista possui apenas um elemento.
    }
    else{


    no *aux;
    aux = e->inicio;
    while (aux->prox != e->inicio){
            printf(" %d ->", aux->info);
            aux = aux->prox;
        }
    printf(" repetição...\n");
    }
}

void busca_atualiza(extremidades *e, int valor_buscado, int valor_atualizado){

    if (e->inicio == NULL){
        printf("A lista está vazia.\n");
        return;
    }

    no *aux;
    int encontrado = 0;

    aux = e->inicio;

    do {
        if (aux->info == valor_buscado){

            aux->info = valor_atualizado;

            printf("O valor %d foi encontrado e substituído por %d.\n",
                   valor_buscado, valor_atualizado);

            encontrado = 1;
            break;
        }

        aux = aux->prox;

    } while (aux != e->inicio);

    if (encontrado == 0){
        printf("O valor %d não está presente na lista.\n", valor_buscado);
    }
}

void liberar_memoria (extremidades *e){

    while (e->inicio != e->fim){
        no *aux;
        aux = e->inicio;
        e->inicio = e->inicio->prox;
        free(aux);
    }
    free(e->inicio);
}



void main(){

    setlocale(LC_ALL, "Portuguese");

    extremidades e = inicializar();

    int opcao, valor, valor_atualizado;

    do {

        printf("====================================\n");
        printf("       LISTA CIRCULAR EM C\n");
        printf("====================================\n");

        printf("\n1 - Inserir no início");
        printf("\n2 - Inserir no fim");
        printf("\n3 - Remover do início");
        printf("\n4 - Remover do fim");
        printf("\n5 - Exibir lista");
        printf("\n6 - Buscar elemento");
        printf("\n0 - Sair");

        printf("\n\nEscolha uma opção: ");
        scanf("%d", &opcao);

        switch(opcao){

            case 1:
                printf("Digite o valor: ");
                scanf("%d", &valor);

                inserir_inicio(&e, valor);
                break;

            case 2:
                printf("Digite o valor: ");
                scanf("%d", &valor);

                inserir_fim(&e, valor);
                break;

            case 3:
                remover_inicio(&e);
                break;

            case 4:
                remover_fim(&e);
                break;

            case 5:
                exibir_lista(&e);
                break;

            case 6:
                printf("Digite o valor que deseja buscar: ");
                scanf("%d", &valor);

                printf("\nDigite um valor para substitui-lo: ");
                scanf("%d", &valor_atualizado);

                busca_atualiza(&e, valor, valor_atualizado);
                break;

            case 0:
                liberar_memoria(&e);
                printf("Encerrando o programa...\n");
                break;

            default:
                printf("Opção inválida!\n");
                break;
        }
        system("pause");
        system("cls");

    } while(opcao != 0);

}
