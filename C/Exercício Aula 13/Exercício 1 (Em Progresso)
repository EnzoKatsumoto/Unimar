#include <stdio.h>
#include <stdlib.h>
#include <locale.h>

typedef struct no {
    int info;
    struct no *prox;
} no;

no* inicializa() {
    return NULL;
}

no* insere_inicio(no *inicio, int valor) {
    no *novo;
    novo = malloc(sizeof(no));
    novo->info = valor;
    novo->prox = inicio;
    return novo;
}

no* insere_final(no *inicio, int valor) {
    no *aux, *novo;
    novo = malloc(sizeof(no));
    novo->info = valor;
    novo->prox = NULL;

    if (inicio == NULL) {
        return novo;
    }

    aux = inicio;
    while (aux->prox != NULL) {
        aux = aux->prox;
    }
    aux->prox = novo;

    return inicio;
}

no* remove_inicio(no *inicio) {
    no *aux;

    if (inicio == NULL) {
        printf("Lista vazia!\n");
    } else {
        aux = inicio;
        inicio = aux->prox;
        free(aux);
        printf("Elemento removido do início com sucesso.\n");
    }
    return inicio;
}

no* remove_final(no *inicio) {
    no *aux;

    if (inicio == NULL) {
        printf("A lista está vazia.\n");
        return NULL;
    }

    if (inicio->prox == NULL) {
        free(inicio);
        printf("Elemento removido do final com sucesso.\n");
        return NULL;
    }

    aux = inicio;
    while (aux->prox->prox != NULL) {
        aux = aux->prox;
    }
    free(aux->prox);
    aux->prox = NULL;
    printf("Elemento removido do final com sucesso.\n");
    return inicio;
}

void buscar_valor(no *inicio, int valor) {
    no *aux;

    if (inicio == NULL) {
        printf("A lista está vazia.\n");
        return;
    }

    aux = inicio;
    while (aux != NULL) {
        if (aux->info == valor) {
            printf("\nValor %d encontrado!\n", valor);
            return;
        }
        aux = aux->prox;
    }
    printf("\nValor %d não encontrado.\n", valor);
}

void exibir_lista(no *inicio) {
    no *aux;

    if (inicio == NULL) {
        printf("A lista está vazia.\n");
        return;
    }

    aux = inicio;
    printf("Lista: ");
    while (aux != NULL) {
        printf("%d -> ", aux->info);
        aux = aux->prox; // Correção: avançava o ponteiro para evitar loop infinito
    }
    printf("NULL\n");
}

no* destroi_lista(no *inicio) {
    no *aux, *aux2;
    aux = inicio;

    while (aux != NULL) {
        aux2 = aux->prox;
        free(aux);
        aux = aux2;
    }
    return NULL;
}

int main() {
    setlocale(LC_ALL, "Portuguese");
    no *lista = inicializa();
    int opcao, valor;

    do {
        printf("\n============================\n");
        printf("      MENU LISTA ENCADEADA   \n");
        printf("============================\n");
        printf("1. Inserir no início\n");
        printf("2. Inserir no final\n");
        printf("3. Remover do início\n");
        printf("4. Remover do final\n");
        printf("5. Exibir lista\n");
        printf("0. Destruir a lista e encerrar\n");
        printf("----------------------------\n");
        printf("Escolha uma opção: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1:
                printf("Digite o valor a ser inserido no início: ");
                scanf("%d", &valor);
                lista = insere_inicio(lista, valor);
                break;

            case 2:
                printf("Digite o valor a ser inserido no final: ");
                scanf("%d", &valor);
                lista = insere_final(lista, valor);
                break;

            case 3:
                lista = remove_inicio(lista);
                break;

            case 4:
                lista = remove_final(lista);
                break;

            case 5:
                exibir_lista(lista);
                break;

            case 0:
                lista = destroi_lista(lista);
                printf("\nLista destruída com sucesso. Encerrando o programa...\n");
                break;

            default:
                printf("\nOpção inválida! Tente novamente entre 0 e 5.\n");
        }
        system("pause");
        system("cls");

    } while (opcao != 0);

    return 0;
}
