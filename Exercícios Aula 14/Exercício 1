
#include <stdio.h>
#include <stdlib.h>

typedef struct no {
    int info;
    struct no *ant;
    struct no *prox;
} No;

// 1. Inserir elemento no inicio
No *inserirInicio(No *inicio, int valor) {
    No *novo = (No *) malloc(sizeof(No));

    if (novo == NULL) {
        printf("Erro ao alocar memoria!\n");
        return inicio;
    }

    novo->info = valor;
    novo->ant = NULL;
    novo->prox = inicio;

    if (inicio != NULL) {
        inicio->ant = novo;
    }

    return novo;
}

// 2. Remover elemento do inicio
No *removerInicio(No *inicio) {
    if (inicio == NULL) {
        printf("A lista esta vazia!\n");
        return NULL;
    }

    No *aux = inicio;
    inicio = inicio->prox;

    if (inicio != NULL) {
        inicio->ant = NULL;
    }

    free(aux);

    printf("Elemento removido do inicio!\n");
    return inicio;
}

// 3. Exibir a lista
void exibirLista(No *inicio) {
    No *aux = inicio;

    if (inicio == NULL) {
        printf("A lista esta vazia!\n");
        return;
    }

    printf("Lista: ");

    while (aux != NULL) {
        printf("%d ", aux->info);
        aux = aux->prox;
    }

    printf("\n");
}

// 4. Exibir a lista invertida
void exibirInvertida(No *inicio) {
    if (inicio == NULL) {
        printf("A lista esta vazia!\n");
        return;
    }

    No *aux = inicio;

    // Percorre ate o ultimo elemento
    while (aux->prox != NULL) {
        aux = aux->prox;
    }

    printf("Lista invertida: ");

    // Percorre do ultimo ate o primeiro
    while (aux != NULL) {
        printf("%d ", aux->info);
        aux = aux->ant;
    }

    printf("\n");
}

// 5. Inserir elemento no fim
No *inserirFim(No *inicio, int valor) {
    No *novo = (No *) malloc(sizeof(No));

    if (novo == NULL) {
        printf("Erro ao alocar memoria!\n");
        return inicio;
    }

    novo->info = valor;
    novo->prox = NULL;
    novo->ant = NULL;

    if (inicio == NULL) {
        return novo;
    }

    No *aux = inicio;

    while (aux->prox != NULL) {
        aux = aux->prox;
    }

    aux->prox = novo;
    novo->ant = aux;

    return inicio;
}

// 6. Remover elemento do fim
No *removerFim(No *inicio) {
    if (inicio == NULL) {
        printf("A lista esta vazia!\n");
        return NULL;
    }

    No *aux = inicio;

    // Procura o ultimo elemento
    while (aux->prox != NULL) {
        aux = aux->prox;
    }

    // Se houver apenas um elemento
    if (aux->ant == NULL) {
        free(aux);
        printf("Elemento removido do fim!\n");
        return NULL;
    }

    aux->ant->prox = NULL;

    free(aux);

    printf("Elemento removido do fim!\n");
    return inicio;
}

// 7. Buscar um valor na lista
void buscarValor(No *inicio, int valor) {
    No *aux = inicio;
    int posicao = 0;

    while (aux != NULL) {
        if (aux->info == valor) {
            printf("Valor %d encontrado na posicao %d.\n",
                   valor, posicao);
            return;
        }

        aux = aux->prox;
        posicao++;
    }

    printf("Valor %d nao encontrado na lista.\n", valor);
}

// 8. Liberar memoria da lista
No *liberarLista(No *inicio) {
    No *aux;

    while (inicio != NULL) {
        aux = inicio;
        inicio = inicio->prox;
        free(aux);
    }

    printf("Memoria liberada!\n");
    return NULL;
}

int main() {
    No *inicio = NULL;
    int opcao, valor;

    do {
        printf("\n===== LISTA DUPLAMENTE ENCADEADA =====\n");
        printf("1 - Inserir no inicio\n");
        printf("2 - Remover do inicio\n");
        printf("3 - Exibir lista\n");
        printf("4 - Exibir lista invertida\n");
        printf("5 - Inserir no fim\n");
        printf("6 - Remover do fim\n");
        printf("7 - Buscar valor\n");
        printf("8 - Liberar memoria\n");
        printf("0 - Sair\n");
        printf("Escolha uma opcao: ");

        if (scanf("%d", &opcao) != 1) {
            printf("Entrada invalida!\n");
            inicio = liberarLista(inicio);
            return 1;
        }

        switch (opcao) {
            case 1:
            case 5:
                printf("Digite o valor: ");

                if (scanf("%d", &valor) != 1) {
                    printf("Entrada invalida!\n");
                    inicio = liberarLista(inicio);
                    return 1;
                }

                if (opcao == 1) {
                    inicio = inserirInicio(inicio, valor);
                } else {
                    inicio = inserirFim(inicio, valor);
                }
                break;

            case 2:
                inicio = removerInicio(inicio);
                break;

            case 3:
                exibirLista(inicio);
                break;

            case 4:
                exibirInvertida(inicio);
                break;

            case 6:
                inicio = removerFim(inicio);
                break;

            case 7:
                printf("Digite o valor a buscar: ");

                if (scanf("%d", &valor) != 1) {
                    printf("Entrada invalida!\n");
                    inicio = liberarLista(inicio);
                    return 1;
                }

                buscarValor(inicio, valor);
                break;

            case 8:
                inicio = liberarLista(inicio);
                break;

            case 0:
                inicio = liberarLista(inicio);
                printf("Programa encerrado!\n");
                break;

            default:
                printf("Opcao invalida!\n");
        }

    } while (opcao != 0);
    system(pause);
    system(cls);
    return 0;
}
